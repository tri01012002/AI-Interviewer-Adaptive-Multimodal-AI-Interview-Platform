# Copy to a private env file and replace every value marked CHANGE_ME.
# Use a URL-safe hex password, for example: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_HEX_SECRET
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
# Same-origin frontend/API needs no cross-origin entries.
ALLOWED_ORIGINS=[]
FRONTEND_URL=https://your-domain.example
# Cloud Compose uses its internal PostgreSQL and Redis services:
# DATABASE_URL=postgresql://ai_interviewer:<POSTGRES_PASSWORD>@postgres:5432/ai_interviewer
# REDIS_URL=redis://redis:6379/0
# Persistent files are shared by API and worker at these in-container paths.
# Keep both paths beneath the mounted /app/storage volume; keep CV_STORAGE_PATH
# beneath STORAGE_PATH.
STORAGE_PATH=/app/storage
CV_STORAGE_PATH=/app/storage/private_cv
# Optional absolute path to the checked-out AI_platform_UI/AI-Interview.
FRONTEND_CONTEXT=../AI_platform_UI/AI-Interview
# Mount a directory containing fullchain.pem and privkey.pem to enable HTTPS.
# Nginx runs as UID/GID 10001; grant that group directory access and key read access (mode 0640).
TLS_CERT_DIR=./certs
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0
