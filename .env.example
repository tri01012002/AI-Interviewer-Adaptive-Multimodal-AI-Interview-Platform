# AI Interviewer - Environment Configuration
# Copy this file to .env and fill in your actual values
# config/settings.py rejects unknown keys in .env, so variables that the
# application does not read are kept below as comments marked [not read].

# ==========================================
# APPLICATION SETTINGS
# ==========================================
ENVIRONMENT=development  # development, staging, production
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=true
LOG_LEVEL=info

# CORS
FRONTEND_URL=http://localhost:3000
# List settings are JSON arrays (pydantic-settings).
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interviewer
SQLALCHEMY_ECHO=false

# Supabase
# [not read] SUPABASE_URL=https://your-project.supabase.co
# [not read] SUPABASE_KEY=your-supabase-key
# [not read] SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# REDIS & CACHE
# ==========================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# ==========================================
# LLM PROVIDERS
# ==========================================

# The default mode is offline and deterministic; no external AI API key is required.
# Set LLM_PROVIDER=mock for clearly labeled, deterministic fixture questions/evaluations.
# Select openai only when a valid OPENAI_API_KEY is explicitly configured.

# Live provider tests are opt-in. Use only synthetic data and a dedicated SQLite
# database for the E2E test; see docs/P0_6_LIVE_AI_VERIFICATION.md.
# These (and the RUN_LIVE_PROVIDER_SMOKE / LIVE_SMOKE_* variables in
# docs/PROVIDER_SMOKE_RUNBOOK.md) are read by tests from the shell environment;
# do not put them in .env (the application settings reject unknown keys).
# [shell env only] RUN_LIVE_AI_TESTS=0
# [shell env only] RUN_LIVE_AI_E2E=0
# [shell env only] LIVE_AI_E2E_DATABASE_URL=sqlite:///./storage/live_ai_e2e_isolated.db

# OpenAI
LLM_PROVIDER=none  # none, mock, or openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-opus-20240229

# Ollama (Local LLM)
# [not read] OLLAMA_BASE_URL=http://localhost:11434
# [not read] OLLAMA_MODEL=mistral

# Embedding Model
EMBEDDING_PROVIDER=none  # none keeps RAG lexical-only; openai requires OPENAI_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=10
VECTOR_STORE_PROVIDER=sqlalchemy_json
RAG_DEMO_CORPUS_VERSION=demo-v1

# ==========================================
# VOICE SERVICES
# ==========================================

# ElevenLabs (TTS)
ELEVEN_LABS_API_KEY=your-eleven-labs-key
ELEVEN_LABS_VOICE_ID=default-voice-id
# [not read] ELEVEN_LABS_MODEL=eleven_monolingual_v1

# AssemblyAI (STT)
ASSEMBLY_AI_API_KEY=your-assembly-ai-key

# Google Cloud Speech (Optional)
# [not read] GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-creds.json

# Azure Speech Services (Optional)
# [not read] AZURE_SPEECH_KEY=your-azure-speech-key
# [not read] AZURE_SPEECH_REGION=eastus

# Voice Settings
VAD_THRESHOLD=0.5
VAD_SAMPLE_RATE=16000
STT_LANGUAGE=en-US
TTS_SPEED=1.0
VOICE_ENABLED=true
VOICE_MAX_AUDIO_CHUNK_BYTES=65536
VOICE_MAX_BUFFER_BYTES=2097152
VOICE_MAX_UTTERANCE_SECONDS=120
VOICE_WS_MAX_MESSAGE_BYTES=131072
VOICE_WS_IDLE_TIMEOUT_SECONDS=300
VAD_PROVIDER=fake
STT_PROVIDER=fake
STT_MODEL=local-fake
STT_TIMEOUT_SECONDS=20
STT_MAX_RETRIES=1
TTS_PROVIDER=fake
TTS_MODEL=local-fake
TTS_TIMEOUT_SECONDS=20
TTS_MAX_RETRIES=1
VOICE_TELEMETRY_ENABLED=true

# ==========================================
# OBSERVABILITY & MONITORING
# ==========================================

# Sentry (Error Tracking)
SENTRY_DSN=https://...@sentry.io/...
# [not read] SENTRY_ENVIRONMENT=development
# [not read] SENTRY_TRACES_SAMPLE_RATE=0.1

# LangWatch (LLM Observability)
LANGWATCH_API_KEY=your-langwatch-key
LANGWATCH_ENABLED=true

# Prometheus
# [not read] PROMETHEUS_PORT=9090
# [not read] PROMETHEUS_ENABLED=true

# DataDog (Optional)
# [not read] DATADOG_API_KEY=your-datadog-api-key
# [not read] DATADOG_APP_KEY=your-datadog-app-key

# ==========================================
# FEATURE FLAGS
# ==========================================

# LaunchDarkly
# [not read] LAUNCH_DARKLY_KEY=your-ld-key

# Feature Flags
ENABLE_VOICE_MODE=true
ENABLE_VIDEO_MODE=false
ENABLE_BROWSER_AGENT=true
ENABLE_RAG_RETRIEVAL=true
ENABLE_STREAMING=true

# ==========================================
# RAG CONFIGURATION
# ==========================================

# Vector Store
VECTOR_STORE_PROVIDER=sqlalchemy_json
VECTOR_STORE_DIMENSION=1536
VECTOR_SIMILARITY_THRESHOLD=0.7

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_STRATEGY=hybrid  # semantic, bm25, hybrid
# [not read] RETRIEVAL_TEMPERATURE=0.7

# Reranking
# [not read] RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=3
RERANKER_THRESHOLD=0.5

# ==========================================
# INTERVIEW SETTINGS
# ==========================================

# Interview Configuration
DEFAULT_INTERVIEW_DURATION=1800  # 30 minutes in seconds
DEFAULT_NUM_QUESTIONS=8
DEFAULT_DIFFICULTY=medium  # easy, medium, hard

# Scoring
MIN_CONFIDENCE_THRESHOLD=0.6
FAIRNESS_CHECK_ENABLED=true

# ==========================================
# FILE STORAGE
# ==========================================

# Local Storage (Development)
STORAGE_TYPE=local  # local, s3, gcs
STORAGE_PATH=./storage
# Private candidate CV files (use an absolute path on persistent storage in production)
CV_STORAGE_PATH=storage/private_cv

# S3 (Production)
# [not read] S3_BUCKET=ai-interviewer-bucket
# [not read] S3_REGION=us-east-1
# [not read] AWS_ACCESS_KEY_ID=your-aws-key
# [not read] AWS_SECRET_ACCESS_KEY=your-aws-secret

# ==========================================
# SECURITY
# ==========================================

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENABLE_DEV_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# For local development only, opt in explicitly and supply private credentials.
# Never use shared/demo credentials or enable this in production.

# CORS & Security
# [not read] CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
# [not read] RATE_LIMIT_REQUESTS=100
# [not read] RATE_LIMIT_PERIOD=60  # seconds

# ==========================================
# CELERY CONFIGURATION
# ==========================================

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================

# offline_simulation never sends; smtp requires every EMAIL_SMTP_* value below
# (STARTTLS is mandatory) and is refused when ENVIRONMENT=test.
EMAIL_PROVIDER=offline_simulation
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
EMAIL_SMTP_TIMEOUT_SECONDS=10

# ==========================================
# BROWSER AGENT SETTINGS
# ==========================================

# [not read] BROWSER_AGENT_ENABLED=true
# [not read] BROWSER_HEADLESS=true
# [not read] BROWSER_TIMEOUT=30  # seconds
# [not read] BROWSER_ALLOWED_DOMAINS=recruiter.example.com

# HyperBrowser
# [not read] HYPERBROWSER_API_KEY=your-hyperbrowser-key

# ==========================================
# EVALUATION & TESTING
# ==========================================

# [not read] EVALUATION_ENABLED=true
# [not read] SYNTHETIC_DATASET_SIZE=100
# [not read] GOLDEN_DATASET_PATH=./data/golden_dataset.jsonl
# [not read] REGRESSION_BASELINE=v1.0

# ==========================================
# DEPLOYMENT SETTINGS
# ==========================================

# Docker
# [not read] DOCKER_REGISTRY=docker.io
# [not read] DOCKER_IMAGE_TAG=latest

# Kubernetes
# [not read] KUBERNETES_NAMESPACE=default
# [not read] KUBERNETES_ENVIRONMENT=development

# ==========================================
# DEBUG & LOGGING
# ==========================================

# [not read] LOG_FORMAT=json  # json, text
# [not read] LOG_FILE=./logs/app.log
# [not read] DEBUG_SQL=false
# [not read] DEBUG_RAG=false

# Sentry Debug
# [not read] SENTRY_DEBUG=false

# ==========================================
# NOTES
# ==========================================
# 1. Never commit actual .env file - use .env.example only
# 2. For production, use secure secrets management (HashiCorp Vault, AWS Secrets Manager)
# 3. Rotate API keys regularly
# 4. Use different credentials for each environment
# 5. Monitor .env changes in CI/CD
