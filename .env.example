# Copy to .env for local development. Never put real credentials in this file.

# Application
APP_NAME=AI Interviewer
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# CORS list fields must use JSON arrays.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Local development uses SQLite. Set DATABASE_URL only for an intentional
# isolated/test or production database; do not copy a placeholder PostgreSQL URL.
DATABASE_URL=sqlite:///./storage/ai_interviewer.db
SQLALCHEMY_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=2
REDIS_SESSION_TTL_SECONDS=300
REDIS_LOCK_TTL_SECONDS=30
REDIS_LOCK_ACQUIRE_TIMEOUT_SECONDS=2
CACHE_TTL=3600

# Security
SECRET_KEY=replace-with-a-random-development-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENABLE_DEV_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# The default mode is offline and deterministic; no external AI API key is required.
# Set LLM_PROVIDER=mock for clearly labeled, deterministic fixture questions/evaluations.
# Select openai only when a valid OPENAI_API_KEY is explicitly configured.

# Live provider tests are opt-in. Use only synthetic data and a dedicated SQLite
# database for the E2E test; see docs/P0_6_LIVE_AI_VERIFICATION.md.
RUN_LIVE_AI_TESTS=0
RUN_LIVE_AI_E2E=0
LIVE_AI_E2E_DATABASE_URL=sqlite:///./storage/live_ai_e2e_isolated.db

# OpenAI
LLM_PROVIDER=none  # none, mock, or openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-opus-20240229

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Embedding Model
EMBEDDING_PROVIDER=none  # none keeps RAG lexical-only; openai requires OPENAI_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=10
QWEN_EMBEDDING_MODEL_PATH=Qwen/Qwen3-Embedding-0.6B
QWEN_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
VECTOR_STORE_PROVIDER=sqlalchemy_json
VECTOR_STORE_DIMENSION=1536
VECTOR_SIMILARITY_THRESHOLD=0.7
RETRIEVAL_TOP_K=5
RETRIEVAL_STRATEGY=hybrid
RERANKER_TOP_K=3
RERANKER_THRESHOLD=0.5
RAG_DEMO_CORPUS_VERSION=demo-v1
ENABLE_RAG_RETRIEVAL=true

# Voice
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_VOICE_ID=default
ASSEMBLY_AI_API_KEY=
VAD_THRESHOLD=0.5
VAD_SAMPLE_RATE=16000
STT_LANGUAGE=en-US
TTS_SPEED=1
VOICE_ENABLED=true
VOICE_MAX_AUDIO_CHUNK_BYTES=65536
VOICE_MAX_BUFFER_BYTES=2097152
VOICE_MAX_UTTERANCE_SECONDS=120
VOICE_WS_MAX_MESSAGE_BYTES=131072
VOICE_WS_IDLE_TIMEOUT_SECONDS=300
VAD_PROVIDER=fake
STT_PROVIDER=fake
STT_MODEL=local-fake
STT_TIMEOUT_SECONDS=20
STT_MAX_RETRIES=1
TTS_PROVIDER=fake
TTS_MODEL=local-fake
TTS_TIMEOUT_SECONDS=20
TTS_MAX_RETRIES=1
VOICE_TELEMETRY_ENABLED=true
ENABLE_VOICE_MODE=true
ENABLE_VIDEO_MODE=false

# Interview behavior
DEFAULT_INTERVIEW_DURATION=1800
DEFAULT_NUM_QUESTIONS=8
DEFAULT_DIFFICULTY=medium
TURN_PROCESSING_LEASE_SECONDS=300
MIN_CONFIDENCE_THRESHOLD=0.6
FAIRNESS_CHECK_ENABLED=true
AUTH_RATE_LIMIT=10
INTERVIEW_RATE_LIMIT=20
VOICE_RATE_LIMIT=60
LLM_JOB_RATE_LIMIT=5

# Observability and workers
OTEL_SERVICE_NAME=ai-interviewer
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
LANGWATCH_API_KEY=
LANGWATCH_ENABLED=true
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600

# Local storage
STORAGE_TYPE=local
STORAGE_PATH=./storage

# Live tests are opt-in. Use synthetic data and the dedicated temporary
# database procedure documented in DATABASE_ARCHITECTURE.md.
RUN_LIVE_AI_TESTS=false
RUN_LIVE_AI_E2E=false
LIVE_AI_E2E_DATABASE_URL=
