# AI Interviewer - Environment Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# APPLICATION SETTINGS
# ==========================================
ENVIRONMENT=development  # development, staging, production
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
LOG_LEVEL=info

# CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interviewer
SQLALCHEMY_ECHO=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# REDIS & CACHE
# ==========================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# ==========================================
# LLM PROVIDERS
# ==========================================

# OpenAI
LLM_PROVIDER=none  # none or openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-opus-20240229

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ==========================================
# VOICE SERVICES
# ==========================================

# ElevenLabs (TTS)
ELEVEN_LABS_API_KEY=your-eleven-labs-key
ELEVEN_LABS_VOICE_ID=default-voice-id
ELEVEN_LABS_MODEL=eleven_monolingual_v1

# AssemblyAI (STT)
ASSEMBLY_AI_API_KEY=your-assembly-ai-key

# Google Cloud Speech (Optional)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-creds.json

# Azure Speech Services (Optional)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# Voice Settings
VAD_THRESHOLD=0.5
VAD_SAMPLE_RATE=16000
STT_LANGUAGE=en-US
TTS_SPEED=1.0
VOICE_ENABLED=true
VOICE_MAX_AUDIO_CHUNK_BYTES=65536
VOICE_MAX_BUFFER_BYTES=2097152
VOICE_MAX_UTTERANCE_SECONDS=120
VOICE_WS_MAX_MESSAGE_BYTES=131072
VOICE_WS_IDLE_TIMEOUT_SECONDS=300
VAD_PROVIDER=fake
STT_PROVIDER=fake
STT_MODEL=local-fake
STT_TIMEOUT_SECONDS=20
STT_MAX_RETRIES=1
TTS_PROVIDER=fake
TTS_MODEL=local-fake
TTS_TIMEOUT_SECONDS=20
TTS_MAX_RETRIES=1
VOICE_TELEMETRY_ENABLED=true

# ==========================================
# OBSERVABILITY & MONITORING
# ==========================================

# Sentry (Error Tracking)
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# LangWatch (LLM Observability)
LANGWATCH_API_KEY=your-langwatch-key
LANGWATCH_ENABLED=true

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_ENABLED=true

# DataDog (Optional)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# ==========================================
# FEATURE FLAGS
# ==========================================

# LaunchDarkly
LAUNCH_DARKLY_KEY=your-ld-key

# Feature Flags
ENABLE_VOICE_MODE=true
ENABLE_VIDEO_MODE=false
ENABLE_BROWSER_AGENT=true
ENABLE_RAG_RETRIEVAL=true
ENABLE_STREAMING=true

# ==========================================
# RAG CONFIGURATION
# ==========================================

# Vector Store
VECTOR_STORE_PROVIDER=supabase  # supabase, pinecone, weaviate
VECTOR_STORE_DIMENSION=1536
VECTOR_SIMILARITY_THRESHOLD=0.7

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_STRATEGY=hybrid  # semantic, bm25, hybrid
RETRIEVAL_TEMPERATURE=0.7

# Reranking
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=3
RERANKER_THRESHOLD=0.5

# ==========================================
# INTERVIEW SETTINGS
# ==========================================

# Interview Configuration
DEFAULT_INTERVIEW_DURATION=1800  # 30 minutes in seconds
DEFAULT_NUM_QUESTIONS=8
DEFAULT_DIFFICULTY=medium  # easy, medium, hard

# Scoring
MIN_CONFIDENCE_THRESHOLD=0.6
FAIRNESS_CHECK_ENABLED=true

# ==========================================
# FILE STORAGE
# ==========================================

# Local Storage (Development)
STORAGE_TYPE=local  # local, s3, gcs
STORAGE_PATH=./storage

# S3 (Production)
S3_BUCKET=ai-interviewer-bucket
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret

# ==========================================
# SECURITY
# ==========================================

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Security
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# ==========================================
# CELERY CONFIGURATION
# ==========================================

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@ai-interviewer.com

# ==========================================
# BROWSER AGENT SETTINGS
# ==========================================

BROWSER_AGENT_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30  # seconds
BROWSER_ALLOWED_DOMAINS=recruiter.example.com

# HyperBrowser
HYPERBROWSER_API_KEY=your-hyperbrowser-key

# ==========================================
# EVALUATION & TESTING
# ==========================================

EVALUATION_ENABLED=true
SYNTHETIC_DATASET_SIZE=100
GOLDEN_DATASET_PATH=./data/golden_dataset.jsonl
REGRESSION_BASELINE=v1.0

# ==========================================
# DEPLOYMENT SETTINGS
# ==========================================

# Docker
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_TAG=latest

# Kubernetes
KUBERNETES_NAMESPACE=default
KUBERNETES_ENVIRONMENT=development

# ==========================================
# DEBUG & LOGGING
# ==========================================

LOG_FORMAT=json  # json, text
LOG_FILE=./logs/app.log
DEBUG_SQL=false
DEBUG_RAG=false

# Sentry Debug
SENTRY_DEBUG=false

# ==========================================
# NOTES
# ==========================================
# 1. Never commit actual .env file - use .env.example only
# 2. For production, use secure secrets management (HashiCorp Vault, AWS Secrets Manager)
# 3. Rotate API keys regularly
# 4. Use different credentials for each environment
# 5. Monitor .env changes in CI/CD
